# Local self-hosted Supabase. Copy to .env and fill from the stack's .env.
# SUPABASE_SECRET_KEY and SUPABASE_SERVICE_ROLE_KEY are server-only.

SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=http://localhost:8000/auth/v1/.well-known/jwks.json

# Direct Postgres (this stack maps db to host port 5434).
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5434/postgres
